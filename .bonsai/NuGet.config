<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The package built from software/. Run this first, from the
         repository root:
             dotnet pack software/Aeon.VertiGate.sln -c Release
         Then install Aeon.VertiGate from the "VertiGate" source in the
         Bonsai package manager. A local build is version 42.42.42-dev0.
         Paths are relative to this file. -->
    <add key="VertiGate" value="../artifacts/package/release" />
  </packageSources>
</configuration>
