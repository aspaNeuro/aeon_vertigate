<Project>
  <PropertyGroup>
    <PackageTags>Aeon VertiGate Harp</PackageTags>
    <!-- The repository, because it is the one link that is true today. The Aeon
         site has no VertiGate page: aeon.swc.ucl.ac.uk/vertigate returns 404, as
         does /devices. Point this at the documentation site once #29 settles
         where that lives. Package metadata cannot be changed after a version is
         published, so a dead link here is permanent. -->
    <PackageProjectUrl>https://github.com/SainsburyWellcomeCentre/aeon_vertigate</PackageProjectUrl>

    <Authors>Sainsbury Wellcome Centre</Authors>
    <Copyright>Copyright © University College London and Contributors</Copyright>

    <!-- This repository keeps one LICENSE at the root, not one per folder. -->
    <PackageLicenseSourcePath>$(MSBuildThisFileDirectory)../../../LICENSE</PackageLicenseSourcePath>
  </PropertyGroup>
</Project>
